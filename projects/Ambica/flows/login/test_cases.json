            },
            {
                "action": "CLICK",
                "selector": "#password"
            },
            {
                "action": "TYPE",
                "selector": "#password",
                "value": "password"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Login\")"
            }
        ],
        "expected_result": "Login attempt rejected safely; SQL query is parameterized and no backend SQL error is exposed"
    },
