    {
        "scenario_name": "Username accepts and rejects the right values",
        "type": "negative",
        "field_under_test": "#username",
        "steps": [
            {
                "action": "CLICK",
                "selector": "#username"
            },
            {
                "action": "TYPE",
                "selector": "#username",
                "value": "{{value}}"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Save\")"
            }
        ],
        "expected_result": "Each value is handled according to Username's rules.",
        "data_table": [
            {
                "case_name": "empty is rejected",
                "values": {
                    "value": ""
                },
                "expected_result": "Username is mandatory, so the application refuses the submission \u2014 either a validation message names Username, or the submit control stays disabled or hidden.",
                "type": "negative"
            },
            {
                "case_name": "whitespace only is rejected",
                "values": {
                    "value": "   "
                },
                "expected_result": "Spaces are not a value: Username is still treated as empty and the submission is refused.",
                "type": "negative"
            },
            {
                "case_name": "single character is accepted",
                "values": {
                    "value": "A"
                },
                "expected_result": "One character is a legal Username and the record saves.",
                "type": "boundary"
            },
            {
                "case_name": "maximum length (255) is accepted",
                "values": {
                    "value": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
                },
                "expected_result": "A Username of exactly 255 characters saves without truncation.",
                "type": "boundary"
            },
            {
                "case_name": "one over the maximum (256) is refused",
                "values": {
                    "value": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
                },
                "expected_result": "The application refuses 256 characters \u2014 a validation message appears, or the field itself stops accepting input at 255. It must not silently truncate and report success.",
                "type": "boundary"
            },
            {
                "case_name": "leading and trailing spaces are trimmed",
                "values": {
                    "value": "  Trimmed Value  "
                },
                "expected_result": "The record is stored as 'Trimmed Value' \u2014 the surrounding spaces are removed rather than saved.",
                "type": "positive"
            },
            {
                "case_name": "special characters are handled",
                "values": {
                    "value": "Test-Value_01 (A/B) &%#"
                },
                "expected_result": "Punctuation is either accepted as a legal Username or rejected with a validation message. It must not raise a server error.",
                "type": "negative"
            },
            {
                "case_name": "unicode and emoji are handled",
                "values": {
                    "value": "\u03a9mega \u00dcnit \ud83d\ude80"
                },
                "expected_result": "Non-ASCII text is stored and displayed unchanged, or rejected with a validation message \u2014 never mangled into question marks.",
                "type": "negative"
            },
            {
                "case_name": "SQL injection is stored as text",
                "values": {
                    "value": "'; DROP TABLE machines;--"
                },
                "expected_result": "The value is treated as literal text \u2014 it is stored or rejected with a validation message, and no database error is shown.",
                "type": "security"
            },
            {
                "case_name": "HTML and script injection is escaped",
                "values": {
                    "value": "<script>alert('xss')</script>"
                },
                "expected_result": "The markup is escaped and rendered as text \u2014 no alert fires and no raw HTML reaches the page.",
                "type": "security"
            },
            {
                "case_name": "template injection is not evaluated",
                "values": {
                    "value": "{{7*7}}"
                },
                "expected_result": "The value is stored verbatim \u2014 the page never shows 49.",
                "type": "security"
            }
        ],
        "_generated": "coverage"
    }
]