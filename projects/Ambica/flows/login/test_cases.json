[
    {
        "scenario_name": "Login with valid username and password",
        "type": "positive",
        "steps": [
            {
                "action": "TYPE",
                "selector": "#username",
                "value": "ambica_user"
            },
            {
                "action": "TYPE",
                "selector": "#password",
                "value": "Valid@123"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Save\")"
            }
        ],
        "expected_result": "User is logged in successfully and the dashboard page is displayed",
        "_generated": "user"
    },
    {
