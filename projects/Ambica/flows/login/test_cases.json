[
    {
        "scenario_name": "Successful Login with Valid Credentials",
        "type": "positive",
        "steps": [
            {
                "action": "NAVIGATE",
                "selector": "window",
                "value": "https://gc-dev.centralindia.cloudapp.azure.com/ambica/auth/login"
            },
            {
                "action": "CLICK",
                "selector": "#username"
            },
            {
                "action": "TYPE",
                "selector": "#username",
                "value": "dd"
            },
            {
                "action": "CLICK",
                "selector": "#password"
            },
            {
                "action": "TYPE",
                "selector": "#password",
                "value": "123456"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Login\")"
            }
        ],
        "expected_result": "User should successfully authenticate and be redirected to the dashboard."
    },
