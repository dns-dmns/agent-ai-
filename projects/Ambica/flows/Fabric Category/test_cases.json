[
    {
        "scenario_name": "Create Fabric Category - Positive Valid Input",
        "type": "positive",
        "steps": [
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Master Data\")"
            },
            {
                "action": "CLICK",
                "selector": "a:has-text(\"Fabric Category\")"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Add Fabric Category\")"
            },
            {
                "action": "TYPE",
                "selector": "#fabricCategory",
                "value": "Cotton Canvas Standard"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Submit\")"
            }
        ],
        "expected_result": "Fabric Category 'Cotton Canvas Standard' is successfully created and displayed in the master table."
    },
    {
        "scenario_name": "Create Fabric Category - Negative Empty Input Validation",
        "type": "negative",
        "steps": [
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Add Fabric Category\")"
            },
            {
                "action": "TYPE",
                "selector": "#fabricCategory",
                "value": ""
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Submit\")"
            }
        ],
        "expected_result": "Form submission is blocked and a mandatory field validation error is displayed."
    },
    {
        "scenario_name": "Create Fabric Category - Boundary Maximum Allowed Length",
        "type": "boundary",
        "steps": [
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Add Fabric Category\")"
            },
            {
                "action": "TYPE",
                "selector": "#fabricCategory",
                "value": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Submit\")"
            }
        ],
        "expected_result": "Fabric Category with exactly 50 characters is successfully accepted and saved."
    },
    {
        "scenario_name": "Create Fabric Category - Boundary Exceeding Max Length",
        "type": "boundary",
        "steps": [
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Add Fabric Category\")"
            },
            {
                "action": "TYPE",
                "selector": "#fabricCategory",
                "value": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Submit\")"
            }
        ],
        "expected_result": "Input is either truncated at 50 characters or submission fails with length boundary validation message."
    },
    {
        "scenario_name": "Create Fabric Category - Negative Duplicate Name Validation",
        "type": "negative",
        "steps": [
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Add Fabric Category\")"
            },
            {
                "action": "TYPE",
                "selector": "#fabricCategory",
                "value": "Cotton Canvas Standard"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Submit\")"
            }
        ],
        "expected_result": "System prevents duplicate record creation and presents error message 'Fabric Category already exists'."
    },
    {
        "scenario_name": "Create Fabric Category - Security Special Characters Injection Check",
        "type": "security",
        "steps": [
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Add Fabric Category\")"
            },
            {
                "action": "TYPE",
                "selector": "#fabricCategory",
                "value": "<script>alert('XSS')</script>"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Submit\")"
            }
        ],
        "expected_result": "Input is sanitized/encoded; script does not execute and string is saved safely or rejected."
    },
    {
        "scenario_name": "Search Fabric Category - Positive Search Existing Record",
        "type": "positive",
        "steps": [
            {
                "action": "CLICK",
                "selector": "input[placeholder=\"Search by Fabric Category\"]"
            },
            {
                "action": "TYPE",
                "selector": "input[placeholder=\"Search by Fabric Category\"]",
                "value": "Cotton"
            }
        ],
        "expected_result": "Table updates dynamically to show only fabric categories containing 'Cotton'."
    },
    {
        "scenario_name": "Search Fabric Category - Reset Filter Workflow",
        "type": "positive",
        "steps": [
            {
                "action": "TYPE",
                "selector": "input[placeholder=\"Search by Fabric Category\"]",
                "value": "Cotton"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Reset\")"
            }
        ],
        "expected_result": "Search input field is cleared and table displays all fabric category records."
    },
    {
        "scenario_name": "Update Fabric Category - Positive Valid Name Update",
        "type": "positive",
        "steps": [
            {
                "action": "CLICK",
                "selector": "table tbody > tr:nth-child(1) button:has-text(\"Edit\"), table tbody > tr:nth-child(1) span > button"
            },
            {
                "action": "TYPE",
                "selector": "#fabricCategory",
                "value": "Denim Premium Blend"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Submit\")"
            }
        ],
        "expected_result": "Category name is updated to 'Denim Premium Blend' and table reflects updated record."
    },
    {
        "scenario_name": "Update Fabric Category - Negative Empty Input Validation",
        "type": "negative",
        "steps": [
            {
                "action": "CLICK",
                "selector": "table tbody > tr:nth-child(1) span > button"
            },
            {
                "action": "TYPE",
                "selector": "#fabricCategory",
                "value": ""
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Submit\")"
            }
        ],
        "expected_result": "Update is blocked and field error is displayed indicating fabric category cannot be empty."
    },
    {
        "scenario_name": "Assign Fabric Category - Machine Assignment and Save",
        "type": "positive",
        "steps": [
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Assign to Sulzer Machines\")"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Save Assignments\")"
            }
        ],
        "expected_result": "Machine assignments are saved successfully with confirmation banner displayed."
    },
    {
        "scenario_name": "Add Modal - Cancel Action Check",
        "type": "ui",
        "steps": [
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Add Fabric Category\")"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Cancel\")"
            }
        ],
        "expected_result": "Add dialog closes without making changes or adding any record to the grid."
    },
    {
        "scenario_name": "Delete Fabric Category - Cancel Deletion Workflow",
        "type": "positive",
        "steps": [
            {
                "action": "CLICK",
                "selector": "table tbody > tr:nth-child(1) button:nth-of-type(3)"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Cancel\")"
            }
        ],
        "expected_result": "Delete confirmation modal closes and the target fabric category remains in the list."
    },
    {
        "scenario_name": "Delete Fabric Category - Confirm Deletion Workflow",
        "type": "positive",
        "steps": [
            {
                "action": "CLICK",
                "selector": "table tbody > tr:nth-child(1) button:nth-of-type(3)"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Yes, Delete\")"
            }
        ],
        "expected_result": "Selected fabric category is deleted and removed from the master list."
    },
    {
        "scenario_name": "Export Fabric Category Data - Positive Excel Export Check",
        "type": "positive",
        "steps": [
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Excel\")"
            }
        ],
        "expected_result": "Excel spreadsheet file download is triggered containing current fabric category master records."
    }
]