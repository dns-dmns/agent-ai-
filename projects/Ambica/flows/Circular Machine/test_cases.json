            },
            {
                "action": "TYPE",
                "selector": "input[formcontrolname=\"machineName\"]",
                "value": "' OR '1'='1' --"
            },
            {
                "action": "TYPE",
                "selector": "input[formcontrolname=\"machineType\"]",
                "value": "SQL Test"
            },
            {
                "action": "TYPE",
                "selector": "input[placeholder=\"Width\"]",
                "value": "40"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Save\")"
            },
            {
                "action": "VERIFY_ROW_ABSENT",
                "selector": "p-table",
                "value": "' OR '1'='1' --"
            }
        ],
        "expected_result": "Database query escapes injection parameters safely without error or unexpected data leakage."
    },
