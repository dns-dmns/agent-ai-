    {
        "scenario_name": "Verify security prevention against XSS injection payload in Machine Name field",
        "type": "security",
        "steps": [
            {
                "action": "NAVIGATE",
                "selector": "https://gc-dev.centralindia.cloudapp.azure.com/ambica/pages/machines/circular"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Add New\")"
            },
            {
                "action": "TYPE",
                "selector": "input[formcontrolname=\"machineName\"]",
                "value": "<script>alert('XSS-Test')</script>"
            },
            {
                "action": "TYPE",
                "selector": "input[formcontrolname=\"machineType\"]",
                "value": "Auto Type"
            },
            {
                "action": "TYPE",
                "selector": "input[placeholder=\"Width\"]",
                "value": "25"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Save\")"
            },
            {
                "action": "VERIFY_ROW_ABSENT",
                "selector": "p-table",
                "value": "<script>alert('XSS-Test')</script>"
            }
        ],
        "expected_result": "XSS script payload is sanitized or rejected and not executed or saved in raw form."
    },
    {
        "scenario_name": "Verify SQL injection string input handling in Machine Name",
        "type": "security",
        "steps": [
            {
                "action": "NAVIGATE",
                "selector": "https://gc-dev.centralindia.cloudapp.azure.com/ambica/pages/machines/circular"
