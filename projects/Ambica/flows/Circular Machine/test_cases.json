[
    {
        "scenario_name": "Navigate to Circular Machine Page",
        "type": "smoke",
        "steps": [
            {
                "action": "NAVIGATE",
                "selector": "https://gc-dev.centralindia.cloudapp.azure.com/ambica/pages/machines/circular"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Machines Data\")"
            },
            {
                "action": "CLICK",
                "selector": "a:has-text(\"Circular Machine\")"
            },
            {
                "action": "VERIFY_URL",
                "selector": "https://gc-dev.centralindia.cloudapp.azure.com/ambica/pages/machines/circular"
            }
        ],
        "expected_result": "User successfully navigates to the Circular Machine master page."
    },
    {
        "scenario_name": "Create Circular Machine with All Valid Fields",
        "type": "positive",
        "steps": [
            {
                "action": "NAVIGATE",
                "selector": "https://gc-dev.centralindia.cloudapp.azure.com/ambica/pages/machines/circular"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Add New\")"
            },
            {
                "action": "TYPE",
                "selector": "input[formcontrolname=\"machineName\"]",
                "value": "CM-2001"
            },
            {
                "action": "TYPE",
                "selector": "input[formcontrolname=\"machineType\"]",
                "value": "Single Jersey"
            },
            {
                "action": "TYPE",
                "selector": "input[placeholder=\"Width\"]",
                "value": "30"
            },
            {
                "action": "TYPE",
                "selector": "input[placeholder=\"Enter capacity\"]",
                "value": "450"
            },
            {
                "action": "TYPE",
                "selector": "input[placeholder=\"Days\"]",
                "value": "2"
            },
            {
                "action": "TYPE",
                "selector": "input[formcontrolname=\"plantLocation\"]",
                "value": "Plant-A"
            },
            {
                "action": "CLICK",
                "selector": "p-dropdown > div"
            },
            {
                "action": "CLICK",
                "selector": "[aria-label=\"Active\"]"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Save\")"
            },
            {
                "action": "VERIFY_ROW_CONTAINS",
                "selector": "table",
                "value": "CM-2001"
            }
        ],
        "expected_result": "New circular machine record CM-2001 is successfully created and appears in the table."
    },
