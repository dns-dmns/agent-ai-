            {
                "action": "TYPE",
                "selector": "#uomName",
                "value": "M"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Submit\")"
            }
        ],
        "expected_result": "Single character UoM 'M' is accepted and saved successfully."
    },
    {
        "scenario_name": "Verify maximum character length (50 characters) UoM Name boundary",
        "type": "boundary",
        "steps": [
            {
