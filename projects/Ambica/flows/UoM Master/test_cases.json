[
    {
        "scenario_name": "Navigate to UoM Master page and verify grid list display",
        "type": "positive",
        "steps": [
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Master Data\")"
            },
            {
                "action": "CLICK",
                "selector": "a:has-text(\"UoM Master\")"
            }
        ],
        "expected_result": "User is navigated to UoM Master view and grid table loaded with ADD UOM button visible."
    },
    {
        "scenario_name": "Create a new UoM with valid standard name",
        "type": "positive",
        "steps": [
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Master Data\")"
            },
            {
                "action": "CLICK",
                "selector": "a:has-text(\"UoM Master\")"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"ADD UOM\")"
            },
            {
                "action": "TYPE",
                "selector": "#uomName",
                "value": "METERS"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Submit\")"
            }
        ],
        "expected_result": "UoM 'METERS' is created successfully and displayed in the grid list."
    },
    {
        "scenario_name": "Attempt to create UoM with empty name input field",
        "type": "negative",
        "steps": [
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Master Data\")"
            },
            {
                "action": "CLICK",
                "selector": "a:has-text(\"UoM Master\")"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"ADD UOM\")"
            },
            {
                "action": "CLICK",
                "selector": "#uomName"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Submit\")"
            }
        ],
        "expected_result": "Validation error appears indicating UoM Name is required, form submission blocked."
    },
    {
        "scenario_name": "Attempt to create duplicate UoM with existing name",
        "type": "negative",
        "steps": [
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Master Data\")"
            },
            {
                "action": "CLICK",
                "selector": "a:has-text(\"UoM Master\")"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"ADD UOM\")"
            },
            {
                "action": "TYPE",
                "selector": "#uomName",
                "value": "FEET"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Submit\")"
            }
        ],
        "expected_result": "Toast notification or inline error indicates duplicate UoM name is not allowed."
    },
    {
        "scenario_name": "Verify minimum single-character UoM Name creation",
