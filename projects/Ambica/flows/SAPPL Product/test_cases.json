[
    {
        "scenario_name": "Create new valid SAPPL Product Name",
        "type": "positive",
        "steps": [
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Master Data\")"
            },
            {
                "action": "CLICK",
                "selector": "a:has-text(\"SAPPL Product\")"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Add Product Name\")"
            },
            {
                "action": "TYPE",
                "selector": "#sapplProductName",
                "value": "SAPPL_ALPHA_001"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Submit\")"
            }
        ],
        "expected_result": "Product name is saved successfully and appears in the master data table."
    },
