        "steps": [
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Machines Data\")"
            },
            {
                "action": "CLICK",
                "selector": "a:has-text(\"Beamer Machine\")"
            },
            {
                "action": "VERIFY_URL",
                "selector": "https://gc-dev.centralindia.cloudapp.azure.com/ambica/pages/machines/beamer"
            }
