[
    {
        "scenario_name": "Create New FG Master Record - Positive Flow",
        "type": "positive",
        "steps": [
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Master Data\")"
            },
            {
                "action": "CLICK",
                "selector": "a:has-text(\"FG Master\")"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Add New\")"
            },
            {
                "action": "TYPE",
                "selector": "input[placeholder=\"Enter FG item code\"]",
                "value": "FG-CODE-101"
            },
            {
                "action": "TYPE",
                "selector": "input[placeholder=\"Enter FG item name\"]",
                "value": "Cotton Weave Fabric A1"
            },
            {
                "action": "TYPE",
                "selector": "input[placeholder=\"Width\"]",
                "value": "58"
            },
            {
                "action": "TYPE",
                "selector": "input[placeholder=\"Length\"]",
                "value": "100"
            },
            {
                "action": "TYPE",
                "selector": "input[placeholder=\"GSM\"]",
                "value": "180"
            },
            {
                "action": "TYPE",
                "selector": "input[placeholder=\"Shrinkage\"]",
                "value": "2"
            },
            {
                "action": "TYPE",
                "selector": "input[placeholder=\"Distance\"]",
                "value": "10"
            },
            {
                "action": "TYPE",
                "selector": "input[placeholder=\"Minutes per unit\"]",
                "value": "15"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Save\")"
            }
        ],
        "expected_result": "FG Master record saved successfully and visible in the table grid."
    },
