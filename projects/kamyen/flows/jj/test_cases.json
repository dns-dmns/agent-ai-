[
    {
        "scenario_name": "Create Valid System User Record",
        "type": "positive",
        "steps": [
            {
                "action": "CLICK",
                "selector": "a[href*='admin/viewAdminModule']"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text('Add')"
            },
            {
                "action": "CLICK",
                "selector": "div.oxd-form-row div.oxd-select-wrapper"
            },
            {
                "action": "TYPE",
                "selector": "input[placeholder='Type for hints...']",
                "value": "Linda Jane Anderson"
            },
            {
                "action": "TYPE",
                "selector": "div.oxd-form-row input.oxd-input:not([type='password'])",
                "value": "qa_valid_user_01"
            },
            {
                "action": "TYPE",
                "selector": "input[type='password']:first-of-type",
                "value": "Welcome@1234"
            },
            {
                "action": "TYPE",
                "selector": "div.oxd-form-row:nth-child(2) input[type='password']",
                "value": "Welcome@1234"
            },
            {
                "action": "CLICK",
                "selector": "button[type='submit']"
            }
        ],
        "expected_result": "System saves record successfully, displays success toast message 'Successfully Saved', and redirects to user list."
    },
