[
  {
    "scenario_name": "Valid credentials reach the dashboard",
    "type": "positive",
    "steps": [
      {
        "action": "TYPE",
        "selector": "input[name='username']",
        "value": "Admin"
      },
      {
        "action": "TYPE",
        "selector": "input[name='password']",
        "value": "admin123"
      },
      {
        "action": "CLICK",
        "selector": "button:has-text('Login')"
      },
      {
        "action": "WAIT",
        "value": "1500"
      },
      {
        "action": "VERIFY_URL",
        "value": "/dashboard"
      },
      {
        "action": "VERIFY_TEXT",
        "selector": "h6.oxd-topbar-header-breadcrumb-module",
        "value": "Dashboard"
      }
    ],
    "expected_result": "The user is logged in successfully and the Dashboard is displayed."
  },
  {
    "scenario_name": "Wrong password is rejected",
    "type": "negative",
    "steps": [
      {
        "action": "TYPE",
        "selector": "input[name='username']",
        "value": "Admin"
      },
      {
        "action": "TYPE",
        "selector": "input[name='password']",
        "value": "wrong-password"
      },
      {
        "action": "CLICK",
        "selector": "button:has-text('Login')"
      },
      {
        "action": "VERIFY_MESSAGE",
        "value": "Invalid credentials"
      },
      {
        "action": "VERIFY_URL",
        "value": "/auth/login"
      }
    ],
    "expected_result": "An 'Invalid credentials' error appears and the user stays on the login page."
  },
  {
    "scenario_name": "Empty username is rejected",
    "type": "negative",
    "steps": [
      {
        "action": "TYPE",
        "selector": "input[name='password']",
        "value": "admin123"
      },
      {
        "action": "CLICK",
        "selector": "button:has-text('Login')"
      },
      {
        "action": "VERIFY_MESSAGE",
        "value": "Required"
      }
    ],
    "expected_result": "A 'Required' validation message appears under the username field."
  },
  {
    "scenario_name": "Empty password is rejected",
    "type": "negative",
    "steps": [
      {
        "action": "TYPE",
        "selector": "input[name='username']",
        "value": "Admin"
      },
      {
        "action": "CLICK",
        "selector": "button:has-text('Login')"
      },
      {
        "action": "VERIFY_MESSAGE",
        "value": "Required"
      }
    ],
    "expected_result": "A 'Required' validation message appears under the password field."
  },
  {
    "scenario_name": "Login page shows the branding and both fields",
    "type": "positive_ui",
    "steps": [
      {
        "action": "VERIFY_VISIBLE",
        "selector": "input[name='username']"
      },
      {
        "action": "VERIFY_VISIBLE",
        "selector": "input[name='password']"
      },
      {
        "action": "VERIFY_TEXT",
        "selector": "h5.oxd-text--h5",
        "value": "Login"
      }
    ],
    "expected_result": "The login form is displayed with both fields ready for input."
  },
  {
    "scenario_name": "SQL injection in the username is handled safely",
    "type": "security",
    "steps": [
      {
        "action": "TYPE",
        "selector": "input[name='username']",
        "value": "' OR '1'='1"
      },
      {
        "action": "TYPE",
        "selector": "input[name='password']",
        "value": "' OR '1'='1"
      },
      {
        "action": "CLICK",
        "selector": "button:has-text('Login')"
      },
      {
        "action": "VERIFY_MESSAGE",
        "value": "Invalid credentials"
      },
      {
        "action": "VERIFY_URL",
        "value": "/auth/login"
      }
    ],
    "expected_result": "The injection attempt is rejected with an invalid-credentials error and no access is granted."
  }
]