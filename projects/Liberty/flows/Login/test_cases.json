            },
            {
                "action": "VERIFY_MESSAGE",
                "selector": "div.p-toast-detail",
                "value": "Invalid credentials"
            }
        ],
        "expected_result": "SQL payload is safely parameterized, attempt is rejected, and no internal errors are exposed."
