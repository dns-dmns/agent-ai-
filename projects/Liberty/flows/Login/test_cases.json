[
    {
        "scenario_name": "Login - Successful Authentication with Valid Credentials",
        "type": "positive",
        "steps": [
            {
                "action": "NAVIGATE",
                "selector": "https://gc-dev.centralindia.cloudapp.azure.com/liberty/auth/login"
            },
            {
                "action": "TYPE",
                "selector": "#username",
                "value": "admin"
            },
            {
                "action": "TYPE",
                "selector": "#password",
                "value": "1234"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Login\")"
            },
            {
                "action": "VERIFY_URL",
                "selector": "https://gc-dev.centralindia.cloudapp.azure.com/liberty/pages/home",
                "value": "https://gc-dev.centralindia.cloudapp.azure.com/liberty/pages/home"
            },
            {
                "action": "VERIFY_MESSAGE",
                "selector": "div.p-toast-detail",
                "value": "Login Successful"
            }
        ],
        "expected_result": "User is successfully logged in, success toast appears, and page redirects to /liberty/pages/home."
    },
