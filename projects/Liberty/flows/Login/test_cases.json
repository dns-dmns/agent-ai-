[
    {
        "scenario_name": "Successful Login with Valid Credentials",
        "type": "positive",
        "steps": [
            {
                "action": "NAVIGATE",
                "selector": "https://gc-dev.centralindia.cloudapp.azure.com/liberty/auth/login"
            },
            {
                "action": "CLICK",
                "selector": "#username"
            },
            {
                "action": "TYPE",
                "selector": "#username",
                "value": "admin"
            },
            {
                "action": "CLICK",
                "selector": "#password"
            },
            {
                "action": "TYPE",
                "selector": "#password",
                "value": "1234"
            },
            {
                "action": "CLICK",
                "selector": "button:has-text(\"Login\")"
            }
        ],
        "expected_result": "User successfully logs in and is redirected to the dashboard."
    },
