# ─────────────────────────────────────────────────────────────────────
# Copy this file to ".env" and fill in your values. Never commit ".env".
# ─────────────────────────────────────────────────────────────────────

# REQUIRED for AI test generation (https://aistudio.google.com/apikey).
# Execution, reporting and the verdict engine work without it.
GEMINI_API_KEY=

# Model ids. Change here instead of editing the code.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_MAX_RETRIES=3

# ── Workspace ────────────────────────────────────────────────────────
# Where projects/, logs/, .trash/ and the SQLite history live.
# Defaults to the folder containing qa_agent.py — set it only if you keep
# test data somewhere else (or inside Docker).
# QA_WORKSPACE=D:/Ai
# QA_DB_PATH=D:/Ai/qa_platform.db
QA_DEFAULT_PROJECT=ERP_Automation

# ── Security ─────────────────────────────────────────────────────────
# Leave empty for a local-only, unauthenticated server (original behaviour).
# Set a value and every endpoint requires it via the X-API-Key header,
# an ?api_key= query parameter, or the qa_api_key cookie the dashboard sets.
QA_API_KEY=
QA_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ── Execution behaviour ──────────────────────────────────────────────
QA_MAX_WORKERS=5
QA_VISION_HEALING=1
QA_VISION_MIN_CONFIDENCE=0.6
QA_SCHEDULER=1
QA_LOG_LEVEL=INFO
QA_PROMPT_ACTIONS_LIMIT=24000
